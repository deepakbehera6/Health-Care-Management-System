<%- include("../headerFooter/header")%>

<div class="card" style="max-width: 600px;margin: 0 auto;">
    <h2>Book an Appointment</h2>
    <form action="/appointments/book" method="post">
        <div class="form-group">
            <label>Select Department</label>
            <select name="department" required>
                <% for(dept of departments){%>
                    <option value="<%= dept._id%>"><%=dept.name%></option>
                    <%}%>
            </select>
        </div>
        <div class="form-group">
            <label>Select Doctor</label>
            <select name="doctor" required>
            <% for(doc of doctors){%>
                    <option value="<%= doc._id%>">Dr.<%=doc.name%></option>
                    <%}%>
            </select>        
        </div>
        <div class="form-group">
            <label>Date & Time</label>
            <input type="datetime-local" name="appointmentDate" required>
        </div>
        <div class="form-group">
            <label>Notes/ Symptoms</label>
            <textarea name="notes"></textarea>
        </div>
        <button type="submit" class="btn btn-success">Conform Booking</button>
    </form>
</div>

<%- include("../headerFooter/footer")%>