<%-include("../headerFooter/header")%>
<h2>Profile Management</h2>
<% if(message){%>
    <div class="card" style="background-color: #d4edda; color: #155724; border-color: #c3e6cb; margin-top: 1rem;">
        <%= message%>

    </div>
    <%}%>
    <% if(error){%>
        <div class="card" style="background-color: #f8d7da; color: #721c24; border-color: #f5c6cb;margin-top: 1rem;">
            <%= error%>
        </div>
        <%}%>

        <div style="display: flex; gap: 20px; margin-top: 1rem;">
            <div class="card" style="flex: 1;">
                <h3>Edit Personal Info</h3>
                <div style="text-align: center; margin-bottom: 1rem;">
                    <%if(user.profilePicture==='default.png'){%>
                        <img src="/css/user.png" class="img">
                        <%} else{%>
                            <img src="<%=user.profilePicture%>" alt="Profile Picture" class="img">
                            <%}%>
     
                </div>
                <form action="/profile/update" method="post" enctype="multipart/form-data">
                    <div class="form-group">
                        <label>Email Address</label>
                        <input type="email" name="email" value="<%= user.email%>" required>
                    </div>
                    <div class="form-group">
                        <label>Role</label>
                        <input type="text" value="<%= user.role %>"disabled style="background-color: #e9ecef;">
                    </div>
                    
                    <div class="form-group">
                        <label >Upload Image</label>
                        <input type="file" name="profilePicture" accept="image/*" >
                    </div>


                    <button type="submit" class="btn btn-success">Update Profile</button>
                </form>
            </div>

            <div class="card" style="flex: 1;">
                <h3>Change Password</h3>
                <form action="/profile/change-password" method="post" style="margin-top: 1rem;">
                    <div class="form-group">
                        <label>Curent Password</label>
                        <input type="password" name="currentPassword" required>
                    </div>
                    <div class="form-group">
                        <label>New Password</label>
                        <input type="password" name="newPassword" required>
                    </div>
                    <div class="form-group">
                        <label>Confirmed Password</label>
                        <input type="password" name="confirmPassword" required>
                    </div>
                    <button type="submit" class="btn btn-warning">Update Password</button>
                </form>
            </div>
        </div>
<%-include("../headerFooter/footer")%>
