<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Health Care Management</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link  href="https://fonts.googleapis.com/css2?family=Poppins&display=swap" rel="stylesheet"/>
    
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <div class="head-icon">
           <i class="fa-solid fa-hospital-user"></i>
            <h1>Health Care System</h1>
        </div>
        
        <nav>
            <div class="home">
                <i class="fa-solid fa-home" style="font-size: 1rem;"></i>
                <a href="/">Home</a>
            </div>
                <% if(typeof user !== "undefined" && user){%>

                    <% if( user.role === "Admin"){%>
                        <div class="dept">
                            <i class="fa-solid fa-laptop-medical" style="font-size: 1rem;"></i>
                            <a href="/departments">Department</a>
                        </div>
                        <div class="appointment">
                            <i class="fa-solid fa-calendar-days"></i>
                            <a href="/appointments">Appointments</a>
                        </div>
                    <%}%>
                    <div class="profile">
                        <i class="fa-solid fa-user" style="font-size: 1rem;"></i>
                        <a href="/profile">Profile</a>
                    </div>
                    <div class="log">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        <a href="/auth/logout">Logout
                           
                        </a>
                        
                    </div>
                     <%if(user.profilePicture==='default.png'){%>
                                <img src="/css/user.png" class="logout">
                            <%} else{%>
                               <img src="<%=user.profilePicture%>" alt="Profile Picture" class="logout">
                                <%}%>
                <%} else{ %>
                    <div class="auth">
                        <i class="fa-solid fa-right-to-bracket"></i>
                        <a href="/auth/login">Login</a>
                    </div>
                    <div class="reg">
                        <i class="fa-solid fa-user-plus" style="font-size: 1rem;"></i>
                        <a href="/auth/register">Register</a>
                    </div>

                    <%}%>
        </nav>
    </header>
    <div class="container">