<%- include("../headerFooter/header")%>
<h2>Admin Dashboard & Analytics</h2>
<div style="display: flex; gap: 20px; margin-top: 20px;">
    <div class="card" style="flex: 1;">
        <h3>Total Patients</h3>
        <p style="font-size: 2rem; color: #3498db;"><%= patientCount%></p>
    </div>
    <div class="card" style="flex: 1;">
        <h3>Total Doctors</h3>
        <p style="font-size: 2rem; color: #2ecc71;"><%= doctorCount%></p>
    </div>
    <div class="card" style="flex: 1;">
        <h3>Appoinntments</h3>
        <p style="font-size: 2rem; color: #e67e22;"><%= appointmentCount%></p>
    </div>  
</div>
<div  class="card">
    <h3>Recent Appointments Overview</h3>
    <table>
        <thead>
            <tr>
                <th>Patient</th>
                <th>Doctor</th>
                <th>Date</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            <% for(app of appointments){%>
                <tr>
                    <td>
                        <%=app.patient?app.patient.name:"N/A"%>
                    </td>
                    <td>
                        <%=app.doctor?app.doctor.name:"N/A"%>
                    </td>
                    <td>
                        <%=new Date(app.appointmentDate).toLocaleString() %>
                    </td>
                    <td>
                       <strong><%=app.status%></strong> 
                    </td>
                </tr>
                
                <%}%>
        </tbody>
    </table>
</div>

<%- include("../headerFooter/footer")%>