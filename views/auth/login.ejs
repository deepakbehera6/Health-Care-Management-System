<%- include("../headerFooter/header")%>
<div class="card" style="max-width: 450px; margin: 2rem auto;">
    <h2>Account Login</h2>
    <form action="/auth/login" method="post">
        <div class="form-group">
            <label>Email Address</label>
            <input type="email" name="email" required placeholder="user@gmail.com">
        </div>
        <div class="form-group">
            <label>Password</label>
            <input type="password" name="password" required>
        </div>
        <button type="submit" class="btn" style="width: 100%;">Login</button>
    </form>
    <p style="margin-top: 1rem; text-align: center;">Don't have an account ?<a href="/auth/register">Register here</a></p>
</div>

<%- include("../headerFooter/footer")%>